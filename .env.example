# Copy this file to .env and fill in your own values. .env is gitignored; never commit a real key.
# Without a key the app still works: Level 2 shows rule-based paths instead of AI ones.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional. Defaults to claude-haiku-5-5 (fast and inexpensive).
ANTHROPIC_MODEL=
