# Copy this file to .env and fill in your own values. .env is gitignored; never commit a real key.
# Without a key the app still works: rules pick the highlight and the card keeps its standard wording;
# only "Ask your own question" needs a key.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional. Defaults to claude-haiku-5-5 (fast and inexpensive).
ANTHROPIC_MODEL=
